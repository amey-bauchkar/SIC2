# MandiMitra Environment Configuration
# Copy this file to .env before starting the server

# Server Port Configuration
PORT=3001
FRONTEND_PORT=3000
NODE_ENV=development

# External Data Sources
# data.gov.in API Key for Agmarknet live price endpoint
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Core Business & Algorithmic Parameters (Frozen Defaults)
DEFAULT_TRANSPORT_COST_PER_KM_QTL=3.0
DEFAULT_STORAGE_COST_PER_DAY_QTL=10.0
DECISION_RISK_K=1.0
DECISION_GAIN_THRESHOLD=20.0
MAX_SEARCH_RADIUS_KM=100.0
ROAD_DISTANCE_FACTOR=1.35

# Feature Flags
# Set to true ONLY if v1-gbm demonstrably beats v0-heuristic on the backtest
ENABLE_V1_GBM=false
